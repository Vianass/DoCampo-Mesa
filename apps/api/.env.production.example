# Modelo de configuração, sem credenciais. Não é um ambiente publicado.
NODE_ENV=production
# Aplicar também no ambiente de instalação/build, para desativar telemetria de instalação.
SCARF_ANALYTICS=false
API_HOST=0.0.0.0
# O PaaS pode fornecer PORT. API_PORT, se definido, tem precedência.
# PORT=8080
MONGODB_URI=
MONGODB_DB_NAME=docampo_demo
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=10
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
# Gerar e injetar no gestor de segredos; nunca colocar no frontend.
JWT_SECRET=
JWT_ISSUER=docampo-api
JWT_AUDIENCE=docampo-web
JWT_TTL_SECONDS=900
# Substituir pela origem HTTPS real do frontend, sem caminho ou barra final.
CORS_ORIGINS=https://web.example.invalid
# Injetar apenas IPs dos proxies efetivamente verificados do fornecedor.
TRUSTED_PROXY_IPS=
# No Render usar PROXY_MODE=render: exige NODE_ENV=production e RENDER=true da plataforma.
PROXY_MODE=ips
SOCKET_ENABLED=true
SOCKET_SYNC_INTERVAL_MS=500
SOCKET_AUTH_INTERVAL_MS=1000
# Fornecedor por decidir. disabled não constitui uma entrega completa com fotografias.
MEDIA_STORAGE=disabled
# Após escolha/aprovação, usar apenas a origem HTTPS pública da própria API.
MEDIA_PUBLIC_BASE=https://api.example.invalid/api/media
# No Render pode omitir MEDIA_PUBLIC_BASE, derivada de RENDER_EXTERNAL_URL.
