# Exemplo local sem credenciais. Copiar para .env apenas para desenvolvimento.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs-dcm-dev&directConnection=true
MONGODB_DB_NAME=docampo_dev
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# A suite de integração NÃO lê .env. Por omissão usa exclusivamente o replica set
# de teste local, na porta 27019. Nunca indicar desenvolvimento/produção.
